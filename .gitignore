# ---- SolidWorks temp and lock files ----
~$*
*.~*
*.swj
*.swp
*.swb
*.sldlfp.bak
*.bak
*.SLDPRT.bak
*.SLDASM.bak
*.SLDDRW.bak
**/_SW_Temp*
# journal files
swxJRNL.*
*.swxJRNL

# ---- MATLAB / Simulink ----
*.asv
*.autosave
*.m~
*.mex*
*.mlappinstall
*.mltbx
slprj/
*.slxc
*.mexw64
codegen/
# rebuilt by matlab/simulink/build_accel_model.m in a second
matlab/simulink/accel_75m.slx
matlab/simulink/*.slx.r20*
matlab/simulink/*.slx.autosave

# ---- Ansys / Fluent ----
cfd/cases/
*.cas
*.cas.h5
*.cas.gz
*.dat.h5
*.dat.gz
*.msh
*.msh.h5
*.trn
*.log
cleanup-fluent*
pyfluent_watchdog.err
*.wbpj
*_files/
.workbench_lock
*.lck
fluent-*.out.bak

# ---- Generated large media we re-make (keep the PNGs that go in the README) ----
media/wake/*_u.png
media/views/*
# the one view README.md embeds stays in git (0.24 MB)
!media/views/formula_single_seater_Default_iso.png
# CFD films, remade by: .venv/Scripts/python cfd/visualise.py all (the PNGs stay in git)
media/cfd/vis/*.mp4
media/cfd/vis/*.gif
# the one CFD GIF embedded at the top of README.md stays in git
!media/cfd/vis/compare_ABCD.gif
# wing-support films (cfd/vis_supports.py): MP4s and GIFs re-made, one GIF kept for the README
media/cfd/supports/*.mp4
media/cfd/supports/*.gif
!media/cfd/supports/supports_compare.gif
# old B and D pictures (simplified CFD bodywork), kept locally after B and D moved to the as-built bodywork (2026-11-25)
media/cfd/vis_old_simplified/

# ---- OS / editor ----
Thumbs.db
desktop.ini
.DS_Store
*.tmp

# ---- terminal harness: compiled exe and the SolidWorks interop DLLs copied next to it ----
tools/sw_harness/bin/

# ---- CFD / Python (aero session) ----
# Fluent outputs: meshes, cases, data, transcripts and solver logs never go in git
cfd/**/*.dat
*.h5
*.cdat
*.cxa
fluent*.trn
# Fluent Meshing CAD cache written next to imported STEP files
*.pmdb
cfd/cases/
# previous copies kept by cfd/fluent_halfcar.py when it would overwrite a file
*.prev.*
# project Python environment (recreate: see cfd/requirements.txt)
.venv/
__pycache__/

# ---- SolidWorks Simulation solver files (re-made by: python tools/sw_run.py ChassisStatics) ----
sim/stress/results/
cad/analysis/old/
cad/chassis/old/sim_results/

**/old/

# ---- showcase films (remade by: python tools/sw_run.py showcase-build, and matlab/make_lap_video.m) ----
media/showcase/frames_build/
media/showcase/frames_lap/
media/showcase/*.mp4
media/showcase/*.gif
# the build-up GIF embedded at the top of README.md stays in git
!media/showcase/car_buildup.gif
# ground plate for the build-up film, remade on every run
cad/showcase/
